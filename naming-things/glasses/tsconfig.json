{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/*"],
      "@core": ["../core/index"]
    }
  },
  "include": ["src/**/*.ts", "../core/**/*.ts"]
}
