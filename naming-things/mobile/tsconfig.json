{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@core/*": ["../core/*"],
      "@core": ["../core/index"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../core/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
